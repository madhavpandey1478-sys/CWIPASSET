{
    "id": "com.madhav.positionentry",
    "version": "1.5.0",
    "name": "Asset Entry",
    "description": "Asset entry and maintenance data entry widget",
    "newInstancePrefix": "PositionEntry",
    "vendor": "Madhav Pandey",
    "eula": "",
    "license": "",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-madhav-positionentry",
            "url": "https://madhavpandey1478-sys.github.io/positionwidget/Pmain.js",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],
    "properties": {
        "width": {
            "type": "integer",
            "default": 1800
        },
        "height": {
            "type": "integer",
            "default": 600
        }
    },
    "methods": {
        "getLastEvent": {
            "returnType": "string",
            "description": "Returns the last event generated by the widget."
        },
        "getData": {
            "returnType": "string",
            "description": "Returns the Create Asset table data."
        },
        "setData": {
            "description": "Sets the Create Asset table data.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "Serialized table data."
                }
            ]
        },
        "setCellValue": {
            "description": "Sets a value in a Create Asset table cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Value to set."
                }
            ]
        },
        "setRowOptions": {
            "description": "Sets dropdown options for a Create Asset row.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array containing dropdown options."
                }
            ]
        }
    },
    "events": {
        "onFieldChange": {
            "description": "Triggered when a field value is changed."
        },
        "onDataEntry": {
            "description": "Triggered when data is entered, a row is added, copied, deleted, cleared, or selected."
        },
        "onSendForApproval": {
            "description": "Triggered when the user clicks Send for Approval."
        },
        "onValidate": {
            "description": "Triggered when the user clicks Validate."
        },
        "onClear": {
            "description": "Triggered when the user clicks Clear."
        }
    }
}
