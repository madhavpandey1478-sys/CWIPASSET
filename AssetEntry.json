{
    "id": "com.madhav.assetentry",
    "version": "1.0.0",
    "name": "CWIP Asset Entry",
    "description": "CWIP asset entry and maintenance data entry widget",
    "newInstancePrefix": "CWIPAssetEntry",
    "vendor": "Madhav Pandey",
    "eula": "",
    "license": "",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-madhav-cwipassetentry",
            "url": "https://madhavpandey1478-sys.github.io/CWIPASSET/cwipassetjs.txt",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],
    "properties": {
        "width": {
            "type": "integer",
            "default": 1800
        },
        "height": {
            "type": "integer",
            "default": 600
        }
    },
    "methods": {
        "getLastEvent": {
            "returnType": "string",
            "description": "Returns the last event generated by the CWIP Asset Entry widget."
        },
        "getData": {
            "returnType": "string",
            "description": "Returns the CWIP Asset Entry table data."
        },
        "setData": {
            "description": "Sets the CWIP Asset Entry table data.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "Serialized table data."
                }
            ]
        },
        "setCellValue": {
            "description": "Sets a value in a CWIP Asset Entry table cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Value to set."
                }
            ]
        },
        "setRowOptions": {
            "description": "Sets dropdown options for a CWIP Asset Entry row.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array containing dropdown options."
                }
            ]
        }
    },
    "events": {
        "onFieldChange": {
            "description": "Triggered when a field value is changed."
        },
        "onDataEntry": {
            "description": "Triggered when data is entered, a row is added, copied, deleted, cleared, or selected."
        },
        "onSendForApproval": {
            "description": "Triggered when the user clicks Send for Approval."
        },
        "onValidate": {
            "description": "Triggered when the user clicks Validate."
        },
        "onClear": {
            "description": "Triggered when the user clicks Clear."
        }
    }
}
